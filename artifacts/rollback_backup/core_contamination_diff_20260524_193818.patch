+    def _enforce_ab_difference(self, p_a_seq, p_b_seq, fragments, target_len):
+        """
+        [AB_DIFFERENCE_GUARD] Ensure B's key fragments differ from A's key fragments.
+        If similarity is too high (e.g., more than 75% overlap of fragment IDs), 
+        find alternative candidates from pool and swap them in B.
+        """
+        a_ids = {f["fragment_id"] for f in p_a_seq if f.get("fragment_id")}
+        b_ids = {f["fragment_id"] for f in p_b_seq if f.get("fragment_id")}
+        
+        if not a_ids or not b_ids:
+            return p_b_seq
+            
+        overlap = a_ids.intersection(b_ids)
+        overlap_ratio = len(overlap) / len(b_ids)
+        
+        if overlap_ratio > 0.75:
+            print(f"[AB_DIFFERENCE_GUARD] High overlap detected ({overlap_ratio:.1%}). Swapping fragments to enforce A/B diversity.")
+            # Find candidate fragments in pool that are NOT in A or B
+            unused_candidates = [
+                f for f in fragments 
+                if f.get("fragment_id") and f["fragment_id"] not in a_ids and f["fragment_id"] not in b_ids
+            ]
+            
+            # Sort unused candidates by edit_value
+            unused_candidates = sorted(
+                unused_candidates, 
+                key=lambda x: float(x.get("structural", {}).get("edit_value", 0.5) or 0.5), 
+                reverse=True
+            )
+            
+            b_seq_copy = list(p_b_seq)
+            target_replace_count = max(1, int(len(b_seq_copy) * 0.25))
+            replaced = 0
+            
+            overlapping_in_b = [f for f in b_seq_copy if f.get("fragment_id") in a_ids]
+            overlapping_in_b = sorted(overlapping_in_b, key=lambda x: float(x.get("structural", {}).get("edit_value", 0.5) or 0.5))
+            
+            for f_to_replace in overlapping_in_b:
+                if replaced >= target_replace_count or not unused_candidates:
+                    break
+                
+                for sub in unused_candidates:
+                    temp_seq = [x for x in b_seq_copy if x.get("fragment_id") != f_to_replace.get("fragment_id")]
+                    if not self._is_contiguous_to_selected(sub, temp_seq):
+                        try:
+                            idx = b_seq_copy.index(f_to_replace)
+                            b_seq_copy[idx] = sub
+                            unused_candidates.remove(sub)
+                            replaced += 1
+                            print(f"[AB_DIFFERENCE_GUARD] Replaced overlapping fragment {f_to_replace.get('fragment_id')} with {sub.get('fragment_id')} in B")
+                            break
+                        except ValueError:
+                            pass
+            
+            return b_seq_copy
+            
+        return p_b_seq
