export interface FragmentThumbnailMeta {
  thumbnail_url?: string;        // blob URL or remote URL for real thumbnail
  thumbnail_time?: number;       // extraction time in seconds
  extraction_version?: number;
  last_updated?: number;
}

// PBE 조각 상태 타입 (구조 SSOT 기준)
export type SelectionState = "S" | "N";
export type FragmentStatus = "candidate" | "committed" | "removed";

export type FragmentRole =
  | "Hook"
  | "Intro"
  | "Context"
  | "Main"
  | "Reaction"
  | "Bridge"
  | "Payoff"
  | "Closing";

export interface Fragment {
  fragment_id: string;       // 기존 호환용 (= fragment_uid 초기값)
  fragment_uid: string;      // 내부 불변 식별자 (절대 재사용 금지)
  root_fragment_uid: string; // 최초 뿌리 조각 UID
  parent_fragment_uid?: string;   // 직전 주 부모 조각 UID
  secondary_parent_uid?: string;  // S|S 분할 시 보조 부모 (R 쪽)
  derivedFrom?: string;           // 호환용 추적 필드 — "uid1+uid2" 형태 허용
  display_id?: string;       // apply 후 사용자에게 보이는 번호
  preview_label?: string;    // 드래그 중 임시 표시명
  selection_state: SelectionState; // S=선택, N=비선택
  status: FragmentStatus;    // candidate | committed | removed
  source_video: string;
  start_frame: number;
  end_frame: number;
  duration: number;
  thumbnail_hue: number;
  fps?: number;
  waveform?: number[];
  thumbnail?: FragmentThumbnailMeta;
  excluded?: boolean; // excluded from render but structurally present for boundaries
  intelligence?: {
    hook_score?: number;
    transcript?: string;
    visual_description?: string;
    role?: FragmentRole;
    dialogue?: number;
    narrative?: number;
    emotional?: number;
    action?: number;
    callback?: number;
    confidence?: number;
  };
}

export interface SourceVideo {
  id: string;
  label: string;
  totalFrames: number;
  fps: number;
  description: string;
}

export const sourceVideos: SourceVideo[] = [];

function makeIntel(): Fragment["intelligence"] {
  return {
    narrative: Math.random(),
    emotional: Math.random(),
    action: Math.random(),
    dialogue: Math.random(),
    hook_score: Math.random(),
    callback: Math.random(),
    confidence: 0.5 + Math.random() * 0.5,
    role: "Main",
    transcript: "",
    visual_description: "",
  };
}

function makeFragments(src: string, count: number, baseHue: number): Fragment[] {
  const frags: Fragment[] = [];
  let frame = 0;
  for (let i = 1; i <= count; i++) {
    const dur = 30 + Math.floor(Math.random() * 180); // 30-210 frames
    const uid = `${src}${i}`;
    frags.push({
      fragment_id: uid,
      fragment_uid: uid,
      root_fragment_uid: uid,
      display_id: uid,
      selection_state: "S" as SelectionState,
      status: "committed" as FragmentStatus,
      source_video: src,
      start_frame: frame,
      end_frame: frame + dur,
      duration: dur,
      thumbnail_hue: baseHue + (i * 15) % 60,
      intelligence: makeIntel(),
    });
    frame += dur;
  }
  return frags;
}

export const allFragments: Record<string, Fragment[]> = {};

// Edit structure – the current video assembly [DEMO SYNC FOR N-04 VERIFICATION]
const makeWaveform = (seed: number) => {
  const wav = [];
  let cur = 0.3;
  for (let i = 0; i < 100; i++) {
    cur += (Math.random() - 0.5) * 0.2;
    cur = Math.max(0.1, Math.min(0.9, cur));
    wav.push(parseFloat(cur.toFixed(2)));
  }
  return wav;
};

export const initialEditFragments: Fragment[] = [];

// Reserved fragments
export const initialReservedFragments: Fragment[] = [];

export function formatDuration(frames: number, fps: number = 30): string {
  const seconds = frames / fps;
  if (seconds < 60) return `${seconds.toFixed(1)}s`;
  const m = Math.floor(seconds / 60);
  const s = (seconds % 60).toFixed(0);
  return `${m}:${s.padStart(2, "0")}`;
}
