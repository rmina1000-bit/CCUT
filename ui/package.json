{
  "name": "ccut-workspace-ui",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "node ./scripts/run-lint-if-available.cjs",
    "build": "vite build",
    "preview": "vite preview",
    "verify:gates": "node ./scripts/run-build-gates.cjs",
    "smoke:mount": "powershell -ExecutionPolicy Bypass -File .\\scripts\\run-component-smoke.ps1",
    "sanity:browser": "powershell -ExecutionPolicy Bypass -File .\\scripts\\run-browser-sanity.ps1",
    "spec:interaction-basic": "powershell -ExecutionPolicy Bypass -File .\\scripts\\run-interaction-basic.ps1",
    "verify:phase": "npm run verify:gates && npm run smoke:mount && npm run sanity:browser"
  },
  "dependencies": {
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slot": "^1.2.4",
    "autoprefixer": "^10.4.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.577.0",
    "postcss": "^8.5.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.2.0",
    "typescript": "^5.9.3",
    "vite": "^5.0.0"
  }
}
