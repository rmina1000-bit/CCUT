# CCUT 백엔드 게이트 — 견본 (이 파일은 커밋된다. 실제 .env는 커밋 안 된다)
# 새 기계에서: 이 파일을 .env로 복사한 뒤 필요한 값만 고친다.
#
# 규칙
#   - 게이트를 세우는 곳은 여기(.env) 하나다. run_backend*.ps1 / .bat 은 세우지 않는다.
#   - 프로세스 환경변수가 .env보다 우선한다 (main.py load_dotenv override=False).
#   - 적지 않은 키 = 코드 기본값. 끄려고 일부러 적을 필요 없다.
#   - 로더: ccut_backend/main.py 상단 (모든 import보다 먼저 — import 시점에 getenv를 읽는 모듈이 있다)

# 승인 관문 (승인 후 편집은 잠금이 아니라 '스토리 단계 복귀'로 처리된다)
CCUT_MODE_GATE=ON

# 2026-07-04 검증 확정 게이트
CCUT_HUB_PLAN=1
CCUT_AUTO_REINDEX=1
CCUT_SINGLE_CACHE=1
CCUT_LEGACY_NARRATIVE=0
CCUT_PERSON_RELINK=1
CCUT_SENSOR_SILERO=OFF
CCUT_TECHNIQUE_WORD_SNAP=OFF
CCUT_TECHNIQUE_AUDIO_FADE=OFF

# 검증 전까지 기본 OFF (적지 않는다):
#   CCUT_REVISION / CCUT_QUALITY_LOG / CCUT_PERSON_REQUERY / CCUT_RUBRIC_ENABLED
#   CCUT_JUDGE_PARALLEL / CCUT_Q_SIGNALS / CCUT_Q_ROLE / CCUT_Q_TECHNIQUES / CCUT_P3_ARRANGE
# 미설정 시 ON인 것 (코드 기본값이 ON — 끄려면 명시):
#   CCUT_STORY_GATE(=ON) / EDIT_CONTRACT_V2(=ON) / CCUT_COMPOUND_INTENT(=1) / CCUT_TAG_PREPASS(=1)
CCUT_ADMIN_LLM_PROVIDER=anthropic
CCUT_ADMIN_LLM_MODEL=claude-fable-5
ANTHROPIC_API_KEY=
